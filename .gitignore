# podcasts/interviewers; do not redistribute via this repo.
transcripts/

# Secrets and local env
.env
.env.*
*.key

# Node (mmx-cli and friends install globally; guard against local installs)
node_modules/

# Logs
*.log

# OS
.DS_Store
Thumbs.db
ehthumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Playwright test artifacts
.playwright-cli/

# MiniMax CLI default output directory
minimax-output/

# Temp files
*.tmp
*.bak
