# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.venv/

# Runtime output — per-interview directories are generated artifacts.
# Keep the repo to skill code + docs + templates only; outputs stay local.
# A curated public sample lives in examples/ instead.
output/

