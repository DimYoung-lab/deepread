# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Runtime output — per-interview directories
# Track all final outputs; ignore only intermediate build artifacts.

# Ignore intermediate JSON data (except visual_content.json for HTML scripts)
output/*/data/*
!output/*/data/visual_content.json

# Ignore per-segment extraction files
output/*/segments/

# Social-platform copy stays as Markdown; do not track generated social PDFs.
output/*/pdf/social-*.pdf

# OS
.DS_Store
Thumbs.db
ehthumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Playwright test artifacts
.playwright-cli/

# MiniMax CLI default output directory
minimax-output/

# Temp files
*.tmp
*.bak
